# PostgreSQL (used by local Docker Compose and future API persistence)
POSTGRES_DB=nodesh
POSTGRES_USER=nodesh
POSTGRES_PASSWORD=nodesh_dev_password
POSTGRES_PORT=5432

# API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://nodesh:nodesh_dev_password@localhost:5432/nodesh
WEB_ORIGIN=http://localhost:3000
UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
MAX_WORKSPACE_DOCUMENTS=25
MAX_WORKSPACE_STORAGE_BYTES=52428800

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
